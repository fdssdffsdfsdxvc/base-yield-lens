{
  "name": "base-yield-lens",
  "version": "0.1.0",
  "description": "Read-only CLI/library to fetch and summarize Base DeFi pool/lending snapshots",
  "type": "module",
  "bin": {
    "base-yield-lens": "./dist/cli.js"
  },
  "main": "./dist/lib/fetch.js",
  "types": "./dist/lib/fetch.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/fetch.d.ts",
      "import": "./dist/lib/fetch.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "keywords": [
    "base",
    "ethereum",
    "defi",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdssdffsdfsdxvc/base-yield-lens.git"
  },
  "homepage": "https://github.com/fdssdffsdfsdxvc/base-yield-lens#readme",
  "bugs": {
    "url": "https://github.com/fdssdffsdfsdxvc/base-yield-lens/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
